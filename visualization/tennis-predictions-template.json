{
  "index_patterns": ["tennis-predictions*"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "document_id": {"type": "keyword"},
        "match_id": {"type": "keyword"},
        "player_a": {"type": "keyword"},
        "player_b": {"type": "keyword"},
        "status": {"type": "keyword"},
        "api_score": {"type": "keyword"},
        "prediction_status": {"type": "keyword"},
        "qualification_status": {"type": "keyword"},
        "predicted_winner": {"type": "keyword"},
        "state_source": {"type": "keyword"},
        "kafka_topic": {"type": "keyword"},
        "model_id": {"type": "keyword"},
        "player_a_win_probability": {"type": "double"},
        "player_b_win_probability": {"type": "double"},
        "sets_a": {"type": "integer"},
        "sets_b": {"type": "integer"},
        "games_a": {"type": "integer"},
        "games_b": {"type": "integer"},
        "partition": {"type": "integer"},
        "parse_ok": {"type": "boolean"},
        "state_ok": {"type": "boolean"},
        "timestamp": {"type": "date"},
        "offset": {"type": "long"},
        "batch_id": {"type": "long"},
        "skip_reason": {"type": "text"}
      }
    }
  }
}
